FROM ghcr.io/saptarshimazumder/pcrent-blender-base-cycles:5.0.1

# Community worker -- cycles variant.  Render-only container: agent.py
# (running on the user's PC, outside the container) does ALL the
# orchestration -- HTTP, heartbeats, downloads, uploads.  This image
# just runs Blender against /input and writes to /output.

# Community-specific render scripts.  Diverge from Vast/Modal scripts
# because the agent's progress parsing has slightly different
# expectations from the cloud workers' inline progress handling.
COPY community_worker/render.sh /render.sh
COPY community_worker/progress_handler.py /progress_handler.py
COPY community_worker/render_driver.py /render_driver.py
COPY community_worker/pre_load.py /pre_load.py
RUN sed -i 's/\r$//' /render.sh && chmod +x /render.sh

ENTRYPOINT ["/render.sh"]
