# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/pcrent?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=pcrent-files

# RunPod serverless (optional)
RUNPOD_API_KEY=rpa_xxx
# Preferred multi-endpoint format: endpoint_id:label,endpoint_id:label
RUNPOD_ENDPOINTS=0e7ke9nvpu3q0c:linux_GPU_farm_1,rtduj166c0aylo:linux_GPU_farm_2
# Legacy single-endpoint fallback (leave empty when using RUNPOD_ENDPOINTS)
RUNPOD_ENDPOINT_ID=
RUNPOD_GPU_MODEL=RunPod Serverless

# Available-machines display/power-score specs for RunPod virtual machines
RUNPOD_GPU_VRAM_GB=24
RUNPOD_CPU_CORES=16
RUNPOD_RAM_GB=64
JOB_STATUS_POLL_INTERVAL_SEC=5
IN_QUEUE_TIMEOUT_SEC=120
IN_PROGRESS_STALE_SEC=5400
# When true, requests marked as throttled are cancelled immediately and retried/failovered.
RUNPOD_KILL_THROTTLED_IMMEDIATELY=true

# Serverless fanout per endpoint used when splitting render-group chunks.
WORKERS_PER_SERVERLESS=3

# Public backend URL used by RunPod/Modal workers for callbacks
PUBLIC_BACKEND_URL=https://your-cloud-run-service-url

# Modal serverless (optional)
MODAL_TOKEN_ID=ak-xxx
MODAL_TOKEN_SECRET=as-xxx
# Endpoint format: gpu_type:Label,gpu_type:Label (gpu_type must match function names in modal_worker/app.py)
MODAL_ENDPOINTS=a10g:Modal A10G 24GB,l4:Modal L4 24GB
MODAL_APP_NAME=pcrent-render
# Either set MODAL_WORKSPACE or MODAL_ENDPOINT_URL_PREFIX so the backend can construct endpoint URLs
MODAL_WORKSPACE=your-modal-workspace
# MODAL_ENDPOINT_URL_PREFIX=https://your-workspace--pcrent-render
# MODAL_ENDPOINT_URL_PREFIX=https://your-workspace--pcrent-render-render-{gpu_type}.modal.run
MODAL_GPU_VRAM_GB=24
MODAL_CPU_CORES=16
MODAL_RAM_GB=64
MODAL_WORKERS_PER_ENDPOINT=3

# Firebase Admin SDK credential file (relative to server/)
FIREBASE_SERVICE_ACCOUNT_PATH=creds/your-firebase-adminsdk-key.json
