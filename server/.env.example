# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/pcrent?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=pcrent-files

# Serverless fanout per endpoint used when splitting render-group chunks.
WORKERS_PER_SERVERLESS=3

# Public backend URL used by Modal/Vast workers for callbacks
PUBLIC_BACKEND_URL=https://your-cloud-run-service-url

# Modal serverless (optional)
MODAL_PROVISIONING_ENABLED=true
MODAL_TOKEN_ID=ak-xxx
MODAL_TOKEN_SECRET=as-xxx
# Endpoint format: gpu_type:Label (gpu_type must match function names in modal_worker/app.py).
# Only a10/a10g is supported by the current Modal worker setup.
MODAL_ENDPOINTS=a10g:Modal A10G 24GB
# Optional denylist of Modal gpu_type values (comma-separated). Default in code is empty.
MODAL_DISABLED_GPU_TYPES=
MODAL_APP_NAME=pcrent-render
# Either set MODAL_WORKSPACE or MODAL_ENDPOINT_URL_PREFIX so the backend can construct endpoint URLs
MODAL_WORKSPACE=your-modal-workspace
# MODAL_ENDPOINT_URL_PREFIX=https://your-workspace--pcrent-render
# MODAL_ENDPOINT_URL_PREFIX=https://your-workspace--pcrent-render-render-{gpu_type}.modal.run
MODAL_GPU_VRAM_GB=24
MODAL_CPU_CORES=16
MODAL_RAM_GB=64
MODAL_WORKERS_PER_ENDPOINT=3

# Firebase Admin SDK credential file (relative to server/)
FIREBASE_SERVICE_ACCOUNT_PATH=creds/your-firebase-adminsdk-key.json
