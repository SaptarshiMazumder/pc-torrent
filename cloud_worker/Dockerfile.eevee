FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

# EEVEE-specific image.  Identical to the cycles image except for the GL/EGL
# stack and a render.sh that hardcodes surfaceless EGL (no Xvfb, no DISPLAY).
#
# Cycles never lands on this image — the orchestrator picks the cycles tag
# for non-EEVEE engines.

# Tell the NVIDIA container runtime (Vast's nvidia-container-toolkit) to inject
# the host's GL/EGL libraries — without "graphics", libEGL_nvidia.so.0 is not
# bind-mounted in and EEVEE has no NVIDIA EGL implementation to load.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,graphics,utility

# Blender system deps + GLVND dispatcher.  GLVND's libEGL.so.1 is the
# vendor-neutral entry point; at runtime it consults the ICD JSON files in
# /usr/share/glvnd/egl_vendor.d/ to pick a vendor (NVIDIA when injected,
# Mesa otherwise).
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget xz-utils libxi6 libxxf86vm1 libxfixes3 \
    libxrender1 libgl1-mesa-glx libxkbcommon0 \
    libsm6 libice6 libxrandr2 libxinerama1 libxcursor1 \
    libegl1-mesa libgles2-mesa \
    libglvnd0 libegl1 libgles2 libopengl0 \
    python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Tell GLVND's libEGL dispatcher to try NVIDIA first.  The 10_ prefix sorts
# before 50_mesa.json so NVIDIA wins when libEGL_nvidia.so.0 is loadable.
RUN mkdir -p /usr/share/glvnd/egl_vendor.d \
    && printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}\n' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# Bake Blender into the image
RUN wget -q https://download.blender.org/release/Blender5.0/blender-5.0.1-linux-x64.tar.xz \
    && tar xf blender-5.0.1-linux-x64.tar.xz \
    && mv blender-5.0.1-linux-x64 /opt/blender \
    && rm blender-5.0.1-linux-x64.tar.xz

RUN mkdir -p /input /output /scripts

# Render scripts.  render.eevee.sh is mounted at /scripts/render.sh so the
# worker handler invokes it the same way as in the cycles image.
COPY cloud_worker/scripts/render.eevee.sh /scripts/render.sh
COPY cloud_worker/scripts/progress_handler.py /scripts/progress_handler.py
COPY cloud_worker/scripts/render_driver.py /scripts/render_driver.py
COPY cloud_worker/scripts/pre_load.py /scripts/pre_load.py
RUN sed -i 's/\r$//' /scripts/render.sh && chmod +x /scripts/render.sh

# Handler deps
RUN pip3 install --no-cache-dir requests==2.32.3

COPY cloud_worker/scripts/handler.py /handler.py

CMD ["python3", "-u", "/handler.py"]
