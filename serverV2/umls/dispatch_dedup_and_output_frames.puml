' =====================================================================
' Neon SQL
' =====================================================================

note as SQL #FFF7ED
  **Neon SQL (run manually)**

  -- dispatch_queue uniqueness
  DELETE FROM dispatch_queue a USING dispatch_queue b
   WHERE a.id < b.id
     AND a.group_id    = b.group_id
     AND a.chunk_index = b.chunk_index;
  ALTER TABLE dispatch_queue ALTER COLUMN chunk_index SET NOT NULL;
  ALTER TABLE dispatch_queue
    ADD CONSTRAINT dispatch_queue_chunk_unique
    UNIQUE (group_id, chunk_index);

  -- new output_frames table
  CREATE TABLE output_frames (
    group_id   TEXT        NOT NULL,
    filename   TEXT        NOT NULL,
    job_id     TEXT        NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    PRIMARY KEY (group_id, filename)
  );
  CREATE INDEX output_frames_job_idx ON output_frames (job_id);

  -- drop the old JSON column (no dead code)
  ALTER TABLE jobs DROP COLUMN output_files;
end note

@enduml
