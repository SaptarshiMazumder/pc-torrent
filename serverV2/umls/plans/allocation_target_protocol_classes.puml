' =====================================================================
' THE TWO TYPES (today and proposed)
' =====================================================================
package "serverV2/core/models.py" <<Frame>> #FEF3C7 {

  interface AllocationTarget <<NEW_Protocol>> #C8E6C9 {
    .. shared scoring / filter surface (consumed by the planner) ..
    + vram_gb : float
    + cpu_cores : int
    + ram_gb : float
    + render_speed : float
    + price_per_hour : float
    + available_seconds : float_or_None
    + cuda_version : str_or_None
    + host_os : str_or_None
    .. discrimination via attribute access (no isinstance) ..
    + fleet_key : str
    + gpu_type_key : str
    + dispatch_fleet : str_or_None
    + startup_buffer_key : str
    --
    + to_planned_task(..fields..) : PlannedTask
  }

  class CommunityMachine <<MODIFIED_dataclass>> #FEF3C7 {
    .. existing fields ..
    + id, gpu_model
    + vram_gb, cpu_cores, ram_gb, render_speed
    + status, last_seen_at, price_per_hour
    + available_seconds
    .. Protocol slots filled None ..
    + cuda_version, host_os
    .. NEW computed properties ..
    + fleet_key, gpu_type_key
    + dispatch_fleet, startup_buffer_key
    .. NEW method ..
    + to_planned_task(...)
  }

  class FleetCapability <<MODIFIED_dataclass>> #FEF3C7 {
    .. existing fields ..
    + fleet, gpu_type, label
    + vram_gb, cpu_cores, ram_gb, render_speed
    + fleet_max_parallel
    + price_per_hour
    + offer_id, cuda_version, host_os
    + available_seconds
    .. NEW computed properties ..
    + fleet_key, gpu_type_key
    + dispatch_fleet, startup_buffer_key
    .. NEW method ..
    + to_planned_task(...)
  }

  class AvailableResources <<dataclass_untouched>> {
    + community_machines : list of CommunityMachine
    + serverless_capabilities : list of FleetCapability
    + serverless_in_flight : dict
  }

  note bottom of AvailableResources #E0E7FF
    **Bucketing stays split** by fleet kind.
    The Protocol unifies the scoring/filter
    surface; the resource snapshot keeps the
    two-bucket shape because community owns
    persistent identity, serverless owns
    fleet_max_parallel capacity.
  end note
}

AllocationTarget <|.. CommunityMachine : implements
AllocationTarget <|.. FleetCapability : implements

' =====================================================================
' UPSTREAM OF THE PLANNER -- pending_allocation_queue (UNTOUCHED)
' Stores the work-item BEFORE allocation runs.  Carries frame range,
' engine, tier, exclusions, overrides -- but ZERO target info, because
' targets only exist after the snapshot is read at planning time.
' =====================================================================
package "serverV2/orchestrator/  pending_allocation_queue  (UNTOUCHED)" <<Frame>> #E0E7FF {

  class PendingAllocationRepository <<existing>> {
    + enqueue(group_id, frame_range, exclusions, overrides) : None
    + claim_next() : PendingAllocationRow_or_None
    + delete(id) : None
  }

  class AllocationPendingTickProcessor <<existing>> {
    + tick() : None
    .. pops queue ; calls planner ; pushes to dispatch_queue ..
  }

  note bottom of AllocationPendingTickProcessor #DCFCE7
    **Why upstream is untouched**
    Pending rows carry (group_id, frame range,
    engine, tier, exclusions, overrides).
    No CommunityMachine, no FleetCapability.
    Targets enter the flow only when the tick
    processor reads the FleetAvailabilitySnapshot
    and hands it to the planner.
  end note
}

' =====================================================================
' DIRECT CONSUMERS OF THE TWO TYPES (the refactor blast radius)
' Three modules touch the types AND do isinstance discrimination.
' =====================================================================
package "serverV2/allocation  (REFACTORED by Protocol)" <<Frame>> #FEF3C7 {

  class AllocationPlanner <<MODIFIED>> #FEF3C7 {
    + plan_initial(...) : list of PlannedTask
    + plan_retry(...) : PlannedTask_or_None
    --
    .. all sub-steps now take target : AllocationTarget ..
    - _eligible_targets(...)
    - _select_with_diversification(...)
    - _distribute_time_balanced(...)
    - _target_to_task(...)
    --
    BEFORE :  9 isinstance branches across helpers
    AFTER  :  zero isinstance branches; reads via Protocol
  }

  class EngineCompatibilityValidator <<MODIFIED>> #FEF3C7 {
    + is_eligible(target, ctx) : bool
    --
    BEFORE :  2 isinstance branches
    AFTER  :  reads target.host_os / target.fleet_key
  }

  class TargetValidator <<protocol_existing>> {
    + is_eligible(target, ctx) : bool
    .. interface now typed as target : AllocationTarget ..
  }
}

AllocationPlanner            ..> AllocationTarget : reads Protocol surface
EngineCompatibilityValidator ..> AllocationTarget : reads Protocol surface
TargetValidator              ..> AllocationTarget : interface signature

