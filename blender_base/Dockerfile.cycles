FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

# Shared bottom-half for every Cycles-rendering worker image (vast,
# modal, community).  Owns the parts that don't differ across fleets:
# Blender install, system deps, python.  Per-fleet images FROM this
# and add only their handler + protocol library on top.
#
# Bump strategy: tag this image after Blender's version
# (pcrent-blender-base-cycles:5.0.1).  When a new Blender drops, bump
# this image's tag, point the per-fleet Dockerfiles' FROM at the new
# tag, push the fleet images.  No per-fleet apt/Blender duplication.

# Blender system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget xz-utils libxi6 libxxf86vm1 libxfixes3 \
    libxrender1 libgl1-mesa-glx libxkbcommon0 \
    libsm6 libice6 libxrandr2 libxinerama1 libxcursor1 \
    libegl1-mesa libgles2-mesa \
    python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Bake Blender into the image
RUN wget -q https://download.blender.org/release/Blender5.0/blender-5.0.1-linux-x64.tar.xz \
    && tar xf blender-5.0.1-linux-x64.tar.xz \
    && mv blender-5.0.1-linux-x64 /opt/blender \
    && rm blender-5.0.1-linux-x64.tar.xz

RUN mkdir -p /input /output /scripts
