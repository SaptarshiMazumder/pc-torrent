@startuml orchestration

!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

title Orchestration Layer — class diagram

' ---------------------------------------------------------------
' Boundary stubs: classes outside orchestration that the layer
' depends on.  Drawn as <<external>> so the eye skips past them.
' ---------------------------------------------------------------
package "Core (data contracts)" <<Frame>> {
    class AvailableResources <<dataclass>> {
        community_machines: list
        serverless_capabilities: list
        serverless_in_flight: dict
    }
    class PlannedTask <<dataclass>> {
        fleet: str
        machine_id?: str
        gpu_type?: str
        label, vram_gb, render_speed
        frame_start, frame_end, frame_step
        chunk_index?, attempt
    }
    class ChunkRequest <<dataclass>> {
        group_id, chunk_index
        frame_start, frame_end, frame_step
        attempt, file_size_bytes?
        excluded_machine_ids
        excluded_serverless_capabilities
    }
}

package "Fleets (boundary)" <<Frame>> {
    interface IFleetStrategy <<external>>
    class FleetRegistry <<external>> {
        +get_or_raise(fleet)
        +is_enabled(fleet)
        +min_frames_per_instance(fleet)
    }
}

package "Repositories (boundary)" <<Frame>> {
    class JobRepository <<external>>
    class RenderGroupRepository <<external>>
    class DispatchQueueRepository <<external>>
    class InProgressChunkRepository <<external>>
}

' ---------------------------------------------------------------
' Orchestration layer
' ---------------------------------------------------------------
package "Orchestration" <<Cloud>> {

    package "Allocation" {
        interface FrameAllocator {
            +allocate_initial(...) : list<PlannedTask>
            +allocate_retry(req, resources) : PlannedTask?
        }
        class DefaultAllocationStrategy {
            +allocate_initial(...)
            +allocate_retry(...)
        }
        class FastRenderAllocationStrategy {
            +allocate_initial(...)
            +allocate_retry(...)
            -HARD_CAP = 12
            -_HEAVINESS_BANDS
        }
    }

    package "Dispatch" {
        class DispatchCoordinator {
            +enqueue_and_flush(group_id, tasks, ctx)
            +drain_for_fleet(fleet) : int
            -_dispatch_queue_item(item)
        }
        class Dispatcher {
            +dispatch_one(task, ctx, job_id)
        }
    }

    class RenderOrchestrator <<facade>> {
        +plan(...) : list<PlannedTask>
        +execute(group_id, tasks, ...) : list<DispatchResult>
        +on_job_failed(job_id, error) : bool
        +cancel_group(group_id) : dict
    }

    class RenderLifecycle {
        +plan(...) : list<PlannedTask>
        +start_render(...) : list<DispatchResult>
        +handle_chunk_failure(job_id, error) : bool
        +cancel_render(group_id) : dict
        -_pick_strategy(file_size, total_frames)
        -_FAST_RENDER_FILE_SIZE_BYTES
        -_FAST_RENDER_TOTAL_FRAMES
    }
}

' ---------------------------------------------------------------
' Relationships
' ---------------------------------------------------------------

' Facade composes lifecycle
RenderOrchestrator *-- RenderLifecycle

' Lifecycle owns / uses
RenderLifecycle --> DispatchCoordinator : enqueue + flush
RenderLifecycle --> FrameAllocator : default + fast
RenderLifecycle --> FleetRegistry : cancel path
RenderLifecycle ..> AvailableResources : reads
RenderLifecycle ..> ChunkRequest : builds on retry

' Strategy realizations
DefaultAllocationStrategy ..|> FrameAllocator
FastRenderAllocationStrategy ..|> FrameAllocator
DefaultAllocationStrategy --> FleetRegistry : min_frames, is_enabled
FastRenderAllocationStrategy --> FleetRegistry : min_frames, is_enabled

' Allocator data flow
FrameAllocator ..> AvailableResources : consumes
FrameAllocator ..> ChunkRequest : consumes (retry)
FrameAllocator ..> PlannedTask : produces

' Dispatch internals
DispatchCoordinator *-- Dispatcher
DispatchCoordinator --> DispatchQueueRepository
DispatchCoordinator --> InProgressChunkRepository
DispatchCoordinator --> JobRepository
Dispatcher --> FleetRegistry : routes by fleet
Dispatcher ..> PlannedTask : consumes

' Lifecycle's repositories (cancel + retry paths)
RenderLifecycle --> JobRepository
RenderLifecycle --> RenderGroupRepository
RenderLifecycle --> InProgressChunkRepository
RenderLifecycle --> DispatchQueueRepository

' Fleet registry holds strategies (boundary edge)
FleetRegistry o-- IFleetStrategy

' Open the file in any PlantUML renderer (VSCode "PlantUML" extension,
' plantuml.com server, etc.) to view.
@enduml
