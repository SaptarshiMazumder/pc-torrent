@startuml allocation_fleet_orchestration
title Allocation, Fleet, and Orchestration Layers -- class structure and dependencies\n(arrow color = source module; green stickies = recent work)

skinparam shadowing false
skinparam BackgroundColor white
skinparam classBackgroundColor #fafafa
skinparam noteBackgroundColor #ffffd0
skinparam packageStyle rectangle
skinparam linetype polyline

' ============================================================
' Layer 1 -- API
' ============================================================
package "API (api/routers)" <<Frame>> #d4e3fc {
    class JobsRouter {
        + agent_failure(job_id, error)
        + register_outputs(job_id, files)
        + update_status(job_id, payload)
        + next_for_machine(machine_id)
        + retry(job_id)
    }
    class RenderGroupsRouter {
        + confirm_upload(group_id, payload)
        + rerender(group_id, payload)
        + cancel(group_id)
    }
    class InternalRouter {
        + report_orphan(job_id, payload)
    }
}

' ============================================================
' Layer 2 -- Service
' ============================================================
package "Service (services)" <<Frame>> #fed7aa {
    class RenderGroupService {
        + confirm_upload()
        + rerender()
        + cancel()
    }
    class JobService {
        + next_for_machine(machine_id)
        + register_outputs(job_id, files)
        + update_status(...)
    }

    note right of RenderGroupService #ddffdd
      RECENT (engine-boundary fix)
      ----
      confirm_upload + rerender resolve
      engine = override OR snapshot, then
      WRITE it back into render_overrides
      BEFORE serializing to JSON.
      Single source of truth for both
      initial dispatch AND retry.
    end note

    note right of JobService #ddffdd
      RECENT (B3 re-shaped)
      ----
      register_outputs detects when
      output_files reaches total_frames
      and fires success_notifier ->
      CallbackRouter.route(SUCCESS).
      Workers cannot self-report "done".
    end note
}

' ============================================================
' Layer 3 -- Orchestration
' ============================================================
package "Orchestration (orchestrator)" <<Frame>> #ddd6fe {
    class RenderOrchestrator <<facade>> {
        + plan(engine, ...)
        + execute(render_overrides_json, ...)
        + on_job_failed(job_id, error)
        + on_job_succeeded(job_id)
        + on_job_progress(...)
        + cancel_group(group_id)
    }

    class RenderLifecycle {
        + plan(engine, ...)
        + start_render(...)
        + handle_chunk_failed(job_id, error)
        + handle_chunk_succeeded(job_id)
        + cancel_render(group_id)
        - _try_dispatch_retry(job_id, error)
        - _load_group_dispatch_context(grp)
        - _record_telemetry(...)
    }

    class DispatchCoordinator {
        + enqueue_and_flush(group_id, tasks, ctx)
        - _dispatch_one(item)
    }

    class Dispatcher {
        + dispatch_one(task, context, job_id)
    }

    note right of RenderLifecycle #ddffdd
      RECENT (multiple)
      ----
      Phase B: retry path strict-checks
        rj.render_overrides_json
        (no silent fallback)
      Engine fix: _load_group_dispatch_context
        reads engine strictly from
        render_overrides_json (snapshot
        fallback removed)
      A2: handle_chunk_succeeded/failed and
        cancel_render now release the
        community machine lock via
        machine_repo.set_available()
    end note

    note right of DispatchCoordinator #ddffdd
      RECENT (Phase A)
      ----
      _engine_from_b64 -> _engine_from_json.
      Reads engine from queue item's
      render_overrides_json directly --
      no base64 decode needed.
    end note
}

' ============================================================
' Layer 4 -- Callbacks
' ============================================================
package "Callbacks (callbacks)" <<Frame>> #cffafe {
    class CallbackRouter {
        + route(job_id, outcome, ...)
    }

    class SuccessHandler {
        + handle(job_id, group_id)
    }
    class FailureHandler {
        + handle(job_id, error)
    }

    note right of CallbackRouter #ddffdd
      ROLE
      ----
      Single funnel for ALL outcome events.
      is_job_terminal short-circuit guard
      collapses duplicate signals to a
      single transition.

      RECENT (B3 re-shape):
        JobService.register_outputs routes
        SUCCESS through here on verified
        completion.

      RECENT (C2):
        ALL failure entry points routed
        through here:
          - agent-failure HTTP
          - /internal/orphan HTTP
          - Vast / Modal in-process monitors
            (_on_failure closure)
          - CommunityMonitor (group-terminal,
            machine-offline detections,
            via the same closure)
        No caller reaches
        RenderOrchestrator.on_job_failed
        directly anymore.
    end note
}

' ============================================================
' Layer 5 -- Allocation
' ============================================================
package "Allocation (orchestrator/allocation)" <<Frame>> #fecaca {
    interface FrameAllocator <<protocol>> {
        + allocate(...)
        + allocate_retry(chunk_request, resources)
    }

    class DefaultAllocationStrategy
    class EconomyAllocationStrategy
    class FastRenderAllocationStrategy

    DefaultAllocationStrategy     -[#dc2626,dashed]-|> FrameAllocator
    EconomyAllocationStrategy     -[#dc2626,dashed]-|> FrameAllocator
    FastRenderAllocationStrategy  -[#dc2626,dashed]-|> FrameAllocator

    class ChunkRequest <<dataclass>> {
        + group_id, chunk_index
        + frame_start, frame_end
        + total_frames, attempt
        + excluded_machine_ids
        + excluded_serverless_capabilities
        + file_size_bytes
        + engine
    }

    class ValidationContext <<dataclass>> {
        + engine
    }

    interface TargetValidator <<protocol>> {
        + is_valid(target, ctx)
    }

    class EngineCompatibilityValidator
    EngineCompatibilityValidator -[#dc2626,dashed]-|> TargetValidator

    note right of EngineCompatibilityValidator #ddffdd
      RECENT (Phase B)
      ----
      Strict: raises ValueError when
      ctx.engine is None.

      Gates EEVEE off:
        modal_serverless (no graphics caps)
        community (WSL2 + NVCT ships only
          compute libs to containers)
      Allows: vast_serverless
    end note
}

' ============================================================
' Layer 6 -- Fleet
' ============================================================
package "Fleet (fleets)" <<Frame>> #bbf7d0 {
    class FleetRegistry {
        + register(strategy)
        + get(fleet)
    }

    interface IFleetStrategy <<protocol>> {
        + dispatch(task, context, job_id)
        + cancel(provider_job_id)
        + stop_monitoring(job_id)
        + provider_job_id_from_job(job)
    }

    package "vast" <<Frame>> #d1fae5 {
        class VastFleetStrategy
        class VastClient
        class VastCallbackHandler
        class VastInstanceMonitor
        class VastRecovery
    }

    package "modal" <<Frame>> #d1fae5 {
        class ModalFleetStrategy
        class ModalClient
        class ModalCallbackHandler
        class ModalJobMonitor
        class ModalRecovery
    }

    package "community" <<Frame>> #d1fae5 {
        class CommunityStrategy
        class CommunityMonitor
    }

    VastFleetStrategy      -[#16a34a,dashed]-|> IFleetStrategy
    ModalFleetStrategy     -[#16a34a,dashed]-|> IFleetStrategy
    CommunityStrategy      -[#16a34a,dashed]-|> IFleetStrategy

    note right of VastClient #ddffdd
      RECENT (Phase A)
      ----
      Accepts render_overrides_json.
      Encodes to base64 ONLY here, right
      before setting RENDER_OVERRIDES_B64
      env var on the docker container.
      Same pattern in modal/client.py.
    end note

    note right of CommunityStrategy
      No provider API call. Dispatch is
      just a JobRepository insert -- the
      DB row IS the message to the agent.
    end note

    note right of CommunityMonitor #ddffdd
      RECENT (C2 extension)
      ----
      Migrated to the same _on_failure
      closure pattern Vast/Modal use.
      Routes through CallbackRouter
      so the is_job_terminal guard
      applies to its detections too.
    end note
}

' ============================================================
' Layer 7 -- Repositories
' ============================================================
package "Repositories (repositories)" <<Frame>> #e5e7eb {
    class JobRepository {
        --table jobs--
        + claim_next_for_machine
        + create / mark_done / mark_failed
        + merge_output_files
        + get_raw_by_id
    }
    class MachineRepository {
        --table machines--
        + set_processing
        + set_available
        + get_available_community
        + mark_stale
    }
    class RenderGroupRepository {
        --table render_groups--
        + get_by_id
        + full_update
    }
    class DispatchQueueRepository {
        --table dispatch_queue--
        + enqueue / dequeue / drain
    }
    class InProgressChunkRepository {
        --in-memory ledger--
        + claim_or_replace
        + release / current_job_for
    }

    note right of JobRepository #ddffdd
      RECENT (A2)
      ----
      claim_next_for_machine atomically
      writes machines.status='processing'
      alongside the job claim.

      RECENT (Phase A)
      ----
      jobs.render_overrides_json column
      now actually contains JSON
      (was holding base64 -- the lie
      that started the engine bug chain).
    end note

    note right of MachineRepository #ddffdd
      RECENT (A2)
      ----
      Stale-sweep WHERE clause now covers
      'processing' too. Crashed-agent locks
      self-heal on the next allocator query.
    end note

    note right of DispatchQueueRepository #ddffdd
      RECENT (Phase A)
      ----
      Column renamed render_overrides_b64
      -> render_overrides_json. Holds JSON
      end-to-end like the jobs table.
    end note
}

' ============================================================
' Cross-layer dependencies (arrow color = source module)
' ============================================================

' --- API outgoing (blue) ---
JobsRouter           -[#2563eb]-> JobService            : status, register, claim
JobsRouter           -[#2563eb]-> CallbackRouter        : agent_failure (post-C2)
JobsRouter           -[#2563eb]-> RenderOrchestrator    : retry_chunk_manually
RenderGroupsRouter   -[#2563eb]-> RenderGroupService    : delegate
InternalRouter       -[#2563eb]-> CallbackRouter        : orphan reports (post-C2)

' --- Service outgoing (orange) ---
RenderGroupService   -[#f97316]-> RenderOrchestrator    : plan + execute + cancel
JobService           -[#f97316]-> CallbackRouter        : success_notifier (B3)
JobService           -[#f97316]-> JobRepository         : merge_output_files etc.

' --- Orchestration outgoing (violet) ---
RenderOrchestrator   *-[#7c3aed]- RenderLifecycle       : facades over
RenderLifecycle      *-[#7c3aed]- DispatchCoordinator   : enqueue + drain
DispatchCoordinator  *-[#7c3aed]- Dispatcher

RenderLifecycle      -[#7c3aed,dashed]-> FrameAllocator        : picks strategy by tier
RenderLifecycle      -[#7c3aed,dashed]-> ChunkRequest          : builds for retry

RenderLifecycle      -[#7c3aed]-> JobRepository         : terminal state writes
RenderLifecycle      -[#7c3aed]-> MachineRepository     : NEW(A2) release on terminal
RenderLifecycle      -[#7c3aed]-> RenderGroupRepository : reads group on retry
RenderLifecycle      -[#7c3aed]-> InProgressChunkRepository : ledger ops

Dispatcher           -[#7c3aed]-> FleetRegistry         : strategy lookup

' --- Callbacks outgoing (cyan) ---
CallbackRouter       -[#0891b2]-> SuccessHandler
CallbackRouter       -[#0891b2]-> FailureHandler
SuccessHandler       -[#0891b2]-> RenderOrchestrator    : on_job_succeeded
FailureHandler       -[#0891b2]-> RenderOrchestrator    : on_job_failed

' --- Allocation outgoing (red) ---
FrameAllocator       -[#dc2626,dashed]-> ValidationContext     : per-allocation ctx
FrameAllocator       -[#dc2626,dashed]-> TargetValidator       : filters targets
FleetRegistry        -[#dc2626,dashed]-> IFleetStrategy        : strategy contract
EngineCompatibilityValidator -[#dc2626,dashed]-> ValidationContext : reads ctx.engine
ChunkRequest                 -[#dc2626,dashed]-> ValidationContext : engine flows from

' --- Fleet outgoing (green) ---
VastFleetStrategy    -[#16a34a]-> VastClient
VastFleetStrategy    -[#16a34a]-> VastCallbackHandler
VastFleetStrategy    -[#16a34a]-> JobRepository         : create job row
VastCallbackHandler  *-[#16a34a]- VastInstanceMonitor   : owns thread per job
VastRecovery         -[#16a34a]-> VastCallbackHandler   : reattach at boot

ModalFleetStrategy   -[#16a34a]-> ModalClient
ModalFleetStrategy   -[#16a34a]-> ModalCallbackHandler
ModalFleetStrategy   -[#16a34a]-> JobRepository
ModalCallbackHandler *-[#16a34a]- ModalJobMonitor       : owns thread per job
ModalRecovery        -[#16a34a]-> ModalCallbackHandler  : reattach at boot

CommunityStrategy    -[#16a34a]-> JobRepository
CommunityMonitor     -[#16a34a,dashed]-> CallbackRouter : via _on_failure closure (post-C2)

VastInstanceMonitor  -[#16a34a,dashed]-> CallbackRouter : via _on_failure / _on_success
ModalJobMonitor      -[#16a34a,dashed]-> CallbackRouter : via _on_failure / _on_success

' ============================================================
' Color legend (placed at the end so the parser sees class
' content first and doesn't mistake the file for an activity
' diagram)
' ============================================================
legend right
  Arrow color = source module
  ----
  blue    = API           (api/routers)
  orange  = Service       (services)
  violet  = Orchestration (orchestrator + lifecycle + dispatch)
  cyan    = Callbacks     (router + handlers)
  red     = Allocation    (strategies + validators)
  green   = Fleet         (registry + per-provider strategy/client/monitor/recovery)
  slate   = Repositories  (DB I/O)
end legend

@enduml
