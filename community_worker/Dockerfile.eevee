FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

# Community EEVEE image.  Identical to Dockerfile.cycles except for the
# GL/EGL stack and a render.sh that hardcodes surfaceless EGL (no Xvfb,
# no DISPLAY).
#
# Cycles never lands on this image — the agent picks the cycles tag for
# non-EEVEE engines (see image_for_engine in agent.py).

# Tell the NVIDIA container runtime to inject the host's GL/EGL libraries.
# Without "graphics", libEGL_nvidia.so.0 is not bind-mounted in and EEVEE
# has no NVIDIA EGL implementation to load.  On Windows Docker Desktop
# WSL2, the "graphics" capability has historically been flaky; if it
# works for the user's setup EEVEE will render, otherwise render.eevee.sh
# logs a clear warning at startup.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,graphics,utility

# Blender system deps + GLVND dispatcher.  GLVND's libEGL.so.1 is the
# vendor-neutral entry point; at runtime it consults the ICD JSON files
# in /usr/share/glvnd/egl_vendor.d/ to pick a vendor (NVIDIA when
# injected, Mesa otherwise).
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget xz-utils libxi6 libxxf86vm1 libxfixes3 \
    libxrender1 libgl1-mesa-glx libxkbcommon0 \
    libsm6 libice6 libxrandr2 libxinerama1 libxcursor1 \
    libegl1-mesa libgles2-mesa \
    libglvnd0 libegl1 libgles2 libopengl0 \
    && rm -rf /var/lib/apt/lists/*

# Tell GLVND's libEGL dispatcher to try NVIDIA first.  The 10_ prefix
# sorts before 50_mesa.json so NVIDIA wins when libEGL_nvidia.so.0 is
# loadable.
RUN mkdir -p /usr/share/glvnd/egl_vendor.d \
    && printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}\n' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# Bake Blender into the image
RUN wget https://download.blender.org/release/Blender5.0/blender-5.0.1-linux-x64.tar.xz \
    && tar xf blender-5.0.1-linux-x64.tar.xz \
    && mv blender-5.0.1-linux-x64 /opt/blender \
    && rm blender-5.0.1-linux-x64.tar.xz

RUN mkdir -p /input /output

# Render scripts.  render.eevee.sh is mounted at /render.sh so the
# entry point stays uniform with Dockerfile.cycles.  Cycles renders
# never land in this image.
COPY community_worker/render.eevee.sh /render.sh
COPY community_worker/progress_handler.py /progress_handler.py
COPY community_worker/render_driver.py /render_driver.py
COPY community_worker/pre_load.py /pre_load.py
RUN sed -i 's/\r$//' /render.sh && chmod +x /render.sh

ENTRYPOINT ["/render.sh"]
