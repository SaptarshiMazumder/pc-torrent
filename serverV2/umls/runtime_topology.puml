@startuml runtime_topology
'
' Runtime topology — orchestration / callbacks / fleet / allocation / monitor.
' Cross-module arrows are colored by their SOURCE module.
'

skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #555555
skinparam ArrowFontSize 11

' Per-module arrow colors (saturated to read against pastel package fills)
!define ARROW_ORCH       #C04040
!define ARROW_CALLBACKS  #D08020
!define ARROW_FLEET      #A040A0
!define ARROW_ALLOC      #2860B0
!define ARROW_MONITOR    #4848A0

title Runtime topology — orchestration / callbacks / fleet / allocation / monitor

' ============================================================
' ORCHESTRATION
' ============================================================

package "orchestration" #FFDDDD {
  class RenderOrchestrator <<facade>> {
    + on_job_succeeded(id)
    + on_job_failed(id, err)
    + on_job_running(id)
    + cancel_one_job(id)
    + retry_chunk_manually(id)
    + handle_community_machine_idle(mid)
  }

  package "lifecycle" #FFCCCC {
    class RenderLifecycle <<workhorse>> {
      + handle_chunk_succeeded(id)
      + handle_chunk_failed(id, err)
      + handle_chunk_running(id)
      + reconcile_group_status(gid)
      + handle_community_machine_idle(mid)
    }
    class RetryExecutor <<retry pipeline>>
    RenderLifecycle --> RetryExecutor
  }

  RenderOrchestrator --> RenderLifecycle
}

' ============================================================
' CALLBACKS
' ============================================================

package "callbacks" #FFEEDD {
  class CallbackRouter <<funnel>> {
    + route(id, outcome, err?)
    -- early-out --
    is_job_terminal(id) ?
  }
  class SuccessHandler
  class FailureHandler

  CallbackRouter --> SuccessHandler
  CallbackRouter --> FailureHandler
}

' ============================================================
' FLEET
' ============================================================

package "fleet" #FFE4FF {
  class FleetRegistry {
    + register(strategy)
    + get(name)
  }

  package "strategies" #FFD0FF {
    interface IFleetStrategy {
      + dispatch(task, ctx, jid)
      + cancel(provider_jid)
    }
    class VastFleetStrategy
    class ModalFleetStrategy
    class CommunityStrategy
    VastFleetStrategy ..|> IFleetStrategy
    ModalFleetStrategy ..|> IFleetStrategy
    CommunityStrategy ..|> IFleetStrategy
  }

  package "clients" #FFD0FF {
    class VastClient {
      + dispatch_job()
      + cancel_job(id)
      + instances.list()
      + instances.destroy(id)
    }
    class ModalClient {
      + dispatch_job()
      + cancel_job(id)
    }
  }

  package "monitors" #FFD0FF {
    class VastFleetMonitor <<singleton, ~10s>> {
      + try_start()
      - _tick()
      - _inspect(row, inst)
    }
    class ModalFleetMonitor <<singleton, ~10s>> {
      + try_start()
      - _tick()
      - _inspect(row)
    }
    class CommunityMonitor <<singleton, ~10s>> {
      + try_start()
      - _tick()
    }
  }

  package "shared" #FFD0FF {
    class JobCounts <<chunk-completion semantics>> {
      + is_complete(job)
      + uploaded(job)
      + rendered(jid, job)
    }
  }

  FleetRegistry o-- VastFleetStrategy
  FleetRegistry o-- ModalFleetStrategy
  FleetRegistry o-- CommunityStrategy
  VastFleetStrategy --> VastClient
  ModalFleetStrategy --> ModalClient
  VastFleetMonitor --> VastClient
  ModalFleetMonitor --> ModalClient
  VastFleetMonitor --> JobCounts
  ModalFleetMonitor --> JobCounts
  CommunityMonitor --> JobCounts
}

' ============================================================
' ALLOCATION
' ============================================================

package "allocation" #DDEEFF {
  class AllocationFacade <<entry>> {
    + plan_initial(...)
    + plan_retry(...)
    + cost_for_dry_run(...)
    + admin_get_config()
    + admin_put_config(d)
  }
  class AllocationClient <<orchestrator-facing>>

  package "planning" #C0DDFF {
    class AllocationPlanningService <<single config reader>> {
      + plan_initial(...)
      + plan_retry(...)
      + cost_for_dry_run(...)
    }
    class AllocationPlanner <<pure-functional>> {
      + plan_initial(weights, ...)
      + plan_retry(req, res, ...)
    }
    class AllocationCostAggregator
    AllocationPlanningService --> AllocationPlanner
    AllocationPlanningService --> AllocationCostAggregator
  }

  package "queues" #C0DDFF {
    class AllocationDispatchQueueRepository <<PG-only>>
    class AllocationPendingQueueRepository <<PG + Redis mirror>>
    class PendingQueueRedisMirror <<sync write-through>>
    AllocationPendingQueueRepository --> PendingQueueRedisMirror
  }

  package "daemon" #C0DDFF {
    class AllocationDispatchQueueDaemon <<every ~2s, lock-gated>> {
      + start()
      + stop()
    }
    class AllocationDispatchTickProcessor
    class AllocationPendingTickProcessor
    class AllocationDispatcher
    AllocationDispatchQueueDaemon --> AllocationDispatchTickProcessor
    AllocationDispatchQueueDaemon --> AllocationPendingTickProcessor
    AllocationDispatchTickProcessor --> AllocationDispatcher
  }

  package "snapshot" #C0DDFF {
    class FleetAvailabilitySnapshotCache <<60s Redis TTL>>
  }

  AllocationClient --> AllocationFacade
  AllocationFacade --> AllocationPlanningService
  AllocationFacade --> AllocationDispatchQueueRepository
  AllocationFacade --> AllocationPendingQueueRepository
  AllocationFacade --> FleetAvailabilitySnapshotCache
}

' ============================================================
' MONITOR
' ============================================================

package "monitor" #DDDDFF {
  class MonitorLockFacade <<entry>> {
    + start()
    + stop()
  }
  class MonitorLockSweeper <<every ~30s, every instance>>
  class MonitorLockRepository <<Redis lock primitive>> {
    + try_acquire(key, owner)
    + refresh(key, owner)
    + release(key, owner)
  }

  package "sweep strategies" #C8C8FF {
    class MonitorLockVastSweepStrategy
    class MonitorLockModalSweepStrategy
    class MonitorLockCommunitySweepStrategy
    class MonitorLockGroupAuditSweepStrategy <<NEW>>
  }

  MonitorLockFacade --> MonitorLockSweeper
  MonitorLockSweeper --> MonitorLockVastSweepStrategy
  MonitorLockSweeper --> MonitorLockModalSweepStrategy
  MonitorLockSweeper --> MonitorLockCommunitySweepStrategy
  MonitorLockSweeper --> MonitorLockGroupAuditSweepStrategy
}

' ============================================================
' Cross-module arrows — colored by SOURCE module
' ============================================================

' callbacks → orchestration  (orange)
SuccessHandler -[ARROW_CALLBACKS]-> RenderOrchestrator : on_job_succeeded
FailureHandler -[ARROW_CALLBACKS]-> RenderOrchestrator : on_job_failed

' orchestration → fleet, allocation  (red)
RenderLifecycle -[ARROW_ORCH]..> FleetRegistry : strategy.cancel(jid)
RenderLifecycle -[ARROW_ORCH]-> AllocationClient : retry parking /\nmanual retry

' fleet → callbacks, monitor  (purple)
VastFleetMonitor -[ARROW_FLEET]..> CallbackRouter : on_failure / on_success / on_running
ModalFleetMonitor -[ARROW_FLEET]..> CallbackRouter : on_failure / on_success
CommunityMonitor -[ARROW_FLEET]..> CallbackRouter : on_failure / on_success
VastFleetMonitor -[ARROW_FLEET]..> MonitorLockRepository : monitor:vast
ModalFleetMonitor -[ARROW_FLEET]..> MonitorLockRepository : monitor:modal
CommunityMonitor -[ARROW_FLEET]..> MonitorLockRepository : monitor:community

' allocation → fleet, monitor  (blue)
AllocationDispatcher -[ARROW_ALLOC]-> FleetRegistry : strategy.dispatch()
AllocationDispatchQueueDaemon -[ARROW_ALLOC]..> MonitorLockRepository : allocation:daemon

' monitor → fleet, orchestration  (indigo)
MonitorLockVastSweepStrategy -[ARROW_MONITOR]-> VastFleetMonitor : try_start()
MonitorLockModalSweepStrategy -[ARROW_MONITOR]-> ModalFleetMonitor : try_start()
MonitorLockCommunitySweepStrategy -[ARROW_MONITOR]-> CommunityMonitor : try_start()
MonitorLockGroupAuditSweepStrategy -[ARROW_MONITOR]-> RenderLifecycle : reconcile_group_status

' ============================================================
' Hidden layout hints — keep modules from sprawling
' ============================================================

callbacks -[hidden]down- fleet
orchestration -[hidden]right- callbacks
fleet -[hidden]down- allocation
allocation -[hidden]right- monitor

@enduml
