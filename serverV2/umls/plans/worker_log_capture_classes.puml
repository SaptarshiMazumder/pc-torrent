package "serverV2/services/jobs/jobs_logger/  <<NEW submodule>>" #E8F5E9 {

  class "JobsLoggerService\n<size:11><i>NEW FILE: jobs_logger_service.py</i></size>" as JobsLogger <<NEW>> #C8E6C9 {
    - mirror     : JobsLoggerRedisMirror
    - r2_repo    : JobsLoggerR2Repository
    - job_repo   : JobRepository         // existing
    - stale_no_chunk_sec  : int = 300
    - upload_url_ttl_sec  : int = 6 * 3600
    + append(env, group_id, job_id, offset,
            gzipped, first_ctx : dict | None) : None
    + read_from_redis(env, group_id, job_id) : bytes | None
    + sign_upload_url(job_id) : str
    + verify_upload_signature(job_id, exp : int,
                              sig : str) : bool
    + write_logs_to_r2() : int
    .. append() -- pure orchestration ..
    // called by router on every worker POST
    if first_ctx is not None:
        mirror.write_meta(env, group_id, job_id,
                          first_ctx)             // first chunk
    mirror.append_chunk(env, group_id, job_id,
                        offset, gzipped)
    mirror.touch_meta(env, group_id, job_id)     // every chunk
    .. write_logs_to_r2() -- pure orchestration ..
    n = 0
    for env, gid, jid in mirror.scan_log_keys():
        meta = mirror.read_meta(env, gid, jid)
        row  = job_repo.get_status(jid)
        terminal = row.status in ('done','failed','cancelled')
        stale    = (now - meta.last_seen_at)
                   > stale_no_chunk_sec
        if not (terminal or stale): continue
        chunks = mirror.read_chunks(env, gid, jid)
        blob   = _concat_by_offset(chunks)
        url    = r2_repo.write_log(
                    env, row.group_id, row.chunk_index,
                    row.attempt, jid, gzip(blob))
        job_repo.stamp_worker_log_url(jid, url)
        mirror.delete(env, gid, jid)
        n += 1
    return n
    .. signed URL (HMAC helpers) ..
    URL:  .../log-append?exp={unix_ts}&sig={hex}
    sig = HMAC_SHA256(server_secret, job_id + "|" + exp)
    .. ZERO redis / r2 / postgres calls in this file ..
    every store touch is delegated.  Service owns the
    DECISIONS (when to write meta, terminal-or-stale
    filter, when to delete) -- not the I/O.
  }

  class "JobsLoggerRedisMirror\n<size:11><i>NEW FILE: jobs_logger_redis_mirror.py</i></size>" as RedisMirror <<NEW>> #C8E6C9 {
    - redis_client : RedisClient
    - ttl_seconds  : int = 600
    + append_chunk(env, group_id, job_id,
                   offset, gzipped) : None
    + write_meta(env, group_id, job_id,
                 first_ctx : dict) : None
    + touch_meta(env, group_id, job_id) : None
    + read_chunks(env, group_id, job_id)
        : list[tuple[int, bytes]]
    + read_meta(env, group_id, job_id) : dict | None
    + scan_log_keys()
        : Iterable[tuple[str, str, str]]
    + delete(env, group_id, job_id) : None
    .. pure Redis I/O, ZERO business logic ..
    // key builders
    _key(env, gid, jid)      = f"logs:{env}:{gid}:{jid}"
    _meta_key(env, gid, jid) = f"logs:meta:{env}:{gid}:{jid}"
    // append_chunk
    pipe.rpush(_key(...), pack(offset, gzipped))
    pipe.expire(_key(...), ttl_seconds)
    // write_meta (first chunk only)
    pipe.hset(_meta_key(...), mapping={
        "attempt", "chunk_index", "fleet",
        "machine_id", "first_seen_at": now})
    pipe.expire(_meta_key(...), ttl_seconds)
    // touch_meta (every chunk)
    pipe.hset(_meta_key(...), "last_seen_at", now)
    pipe.expire(_meta_key(...), ttl_seconds)
    // scan_log_keys
    for k in client.scan_iter("logs:*"):
        if k.startswith("logs:meta:"): continue
        yield _parse(k) -> (env, gid, jid)
    .. fail-open ..
    RedisError -> log.warning + no-op.
    Reads return None/[] on failure.
    Mirrors the RenderGroupRedisMirror pattern
    (services/render_groups/telemetry/) --
    same fail-open + pipeline shape.
  }

  class "JobsLoggerR2Repository\n<size:11><i>NEW FILE: jobs_logger_r2_repository.py</i></size>" as R2Repo <<NEW>> #C8E6C9 {
    - r2_client : R2Client
    - bucket    : str
    + write_log(env, group_id, chunk_index,
                attempt, job_id,
                gzipped : bytes) : str
    + read_log(url : str) : bytes           // future
    + list_logs_for_group(env, group_id)    // future
        : list[dict]
    .. pure R2 I/O, ZERO business logic ..
    // path builder (only place that knows layout)
    path = f"worker-logs/{env}/{group_id}/" \\
           f"chunk_{chunk_index}/" \\
           f"attempt_{attempt}__{job_id}.log.gz"
    r2_client.put_object(
        bucket, path, gzipped,
        content_type="application/gzip",
        content_encoding="gzip",
        tags={"created_date": today_iso(),
              "env": env},
    )
    return r2_client.public_url_for(bucket, path)
    .. read_log / list_logs_for_group ..
    Reserved for later -- frontend instance card
    fallback fetch, admin "download all logs for
    a render" bulk export, etc.
  }
}

