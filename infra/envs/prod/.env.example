# ============================================================
# Forge -- prod environment
# Copy to .env (gitignored).  See dev/.env.example for field meanings.
#
# PROD-SPECIFIC: the desktop installer for this env is LOCKED at
# build time -- VITE_BACKEND_URL is baked, localStorage override is
# removed.  See infra/scripts/build-desktop.sh.
# ============================================================

ENV_NAME=prod
GCP_PROJECT=gen-lang-client-0545494042
GCP_REGION=asia-northeast1
SERVICE_NAME=pc-rent-server-v2-prod

FIREBASE_PROJECT_ID=pc-rent-prod
FIREBASE_SERVICE_ACCOUNT_JSON=

DATABASE_URL=
REDIS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pc-rent-prod-blends

PUBLIC_BACKEND_URL=

MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=pc-rent-render-prod
MODAL_WORKSPACE=
MODAL_WORKER_IMAGE_CYCLES=ghcr.io/saptarshimazumder/pc-rent-modal-worker-cycles:prod-v0.0.0

VAST_API_KEY=
VAST_DOCKER_IMAGE=ghcr.io/saptarshimazumder/pc-rent-vast-worker-cycles:prod-v0.0.0
VAST_DOCKER_IMAGE_EEVEE=ghcr.io/saptarshimazumder/pc-rent-vast-worker-eevee:prod-v0.0.0

COMMUNITY_WORKER_IMAGE=ghcr.io/saptarshimazumder/pc-rent-community-worker-cycles:prod-v0.0.0

ANTHROPIC_API_KEY=PLACEHOLDER_REPLACE_ME
OPENAI_API_KEY=

ORPHAN_SECRET=
