# Node
node_modules/
dist/
build/
.next/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Env files
.env
.env.*
!.env.example
# desktop/.env holds committed, non-secret Vite defaults (public firebase web
# config + backend URL).  desktop/.env.local stays ignored (per-env override
# written by desktop-dev.sh / desktop-build.sh).
!desktop/.env

# desktop-dev.sh backups (created when patching source in-place for tauri dev)
desktop/**/*.bak

# Python
__pycache__/
*.py[cod]
.venv/
venv/
agent/output/

# Local app/runtime data
server/pcrent.db
server/jobs/

# Generated render-image artifacts (server-side build, community-worker
# bundle, anywhere they show up).
**/pcrent-render.tar
**/pcrent-render.tar.gz
**/pcrent-render.sha256

# Built Tauri agent binaries — produced by the desktop build, never
# committed.
**/pcrent-agent-*.exe
**/pcrent-agent-*-pc-windows-*.exe

# OS/IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Service account credentials — never commit these
server/*-adminsdk-*.json
server/gen-lang-client-*.json
server/creds/*.json

# Per-env infra config (templates are committed; real configs gitignored)
infra/envs/*/desktop.config.json
infra/envs/*/.env
infra/.build/

# Terraform local state + plan artefacts (state itself lives in GCS)
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.backup
infra/terraform/**/.terraform.lock.hcl
infra/terraform/**/*.tfplan