' ============================================================
' LAYER 6 -- THE WORK: Serializer adds five fields
' ============================================================
package "services/render_groups" <<Frame>> #fde2e4 {

    class RenderGroupSerializer <<CHANGED>> {
        + serialize_task(job, machine, ...)
        --
        TODAY exposes (per-task DTO):
          frame_start, frame_end, status,
          rendered_frames, estimated_cost_usd, ...
        --
        **P2 ADDS five fields:**
          + started_at                  -- raw, ISO string
          + completed_at                -- raw, ISO string
          + price_per_hour_at_dispatch  -- raw float
          + actual_seconds              -- computed
          + actual_cost_usd             -- computed
        --
        **Compute rules (in serializer, single source of truth):**
          end = completed_at
                  or (status running/uploading ? now : null)
          actual_seconds =
              (end - started_at).total_seconds()
              if started_at and end else null
          actual_cost_usd =
              actual_seconds × price / 3600
              if actual_seconds and price else null
        --
        Null hygiene: pre-Phase-5 jobs / community
        jobs pre-fix → fields stay null; UI renders "—".
    }

    class RenderGroupService <<CHANGED>> {
        + get_render_group(...)
        --
        TODAY returns:
          status, total_frames, tasks[], ...
        --
        **P2 ADDS to group response:**
          + total_actual_cost_usd =
              Σ(task.actual_cost_usd ?? 0)
        --
        Cheap rollup; no extra SQL.
    }

    RenderGroupService --> RenderGroupSerializer : per-task serialize
    RenderGroupService ..> JobsRow                : SELECT (existing query)
