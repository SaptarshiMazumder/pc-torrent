# ============================================================
# Forge -- dev environment
# Copy this to .env (gitignored) and fill in.  Values produced by
# `terraform output` should overwrite their lines automatically when
# you run `infra/scripts/deploy.sh dev` for the first time.
# ============================================================

# -------- Identity (set manually before first apply) ----------------
ENV_NAME=dev
GCP_PROJECT=gen-lang-client-0545494042
GCP_REGION=asia-northeast1
SERVICE_NAME=pcrent-server-v2-dev

# Firebase project for THIS env -- you create it manually in the
# Firebase Console once, paste the service-account JSON below.
FIREBASE_PROJECT_ID=pcrent-dev
FIREBASE_SERVICE_ACCOUNT_JSON=

# -------- Data layer (filled by `terraform output`) -----------------
DATABASE_URL=
REDIS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pcrent-dev-blends

# -------- Public URL (filled by Cloud Run after first deploy) ------
PUBLIC_BACKEND_URL=

# -------- Modal (one workspace, per-env app name) -----------------
# Generate per-env token via `modal token new`; paste here.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=pcrent-render-dev
MODAL_WORKSPACE=
MODAL_WORKER_IMAGE_CYCLES=ghcr.io/saptarshimazumder/pcrent-modal-worker-cycles:dev-v0.0.0

# -------- Vast.ai (single account, per-env image tags) ------------
VAST_API_KEY=
VAST_DOCKER_IMAGE=ghcr.io/saptarshimazumder/pcrent-vast-worker-cycles:dev-v0.0.0
VAST_DOCKER_IMAGE_EEVEE=ghcr.io/saptarshimazumder/pcrent-vast-worker-eevee:dev-v0.0.0

# -------- Community (the agent on user PCs pulls this) ------------
# Required.  serverV2 boot fails loud if missing.  Returned by
# GET /community/worker-image so a single agent binary works against
# any env -- whichever backend it's pointed at, it gets the right tag.
COMMUNITY_WORKER_IMAGE=ghcr.io/saptarshimazumder/pcrent-community-worker-cycles:dev-v0.0.0

# -------- LLM providers (per-env keys; OpenAI required) -----------
ANTHROPIC_API_KEY=PLACEHOLDER_REPLACE_ME
OPENAI_API_KEY=

# -------- Internal -----------------------------------------------
ORPHAN_SECRET=
