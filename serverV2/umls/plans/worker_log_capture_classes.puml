@startuml worker_log_capture_classes
title Plan: worker log capture -> Redis (live) -> R2 (write), per attempt\n(green = NEW entry; green-filled box = NEW class/file)

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #444
}
skinparam package {
  BackgroundColor #F4F4F4
  BorderColor #888
}

!define NEW <color:#1B7A3E><b>
!define NEW_END </b></color>

' ============================================================
' WORKER SIDE -- runs inside each render container
' ============================================================
package "worker_core/  <<shared by all fleets>>" #E1F5FE {

  class "LogStreamer\n<size:11><i>NEW FILE: log_streamer.py</i></size>" as LogStreamer <<NEW>> #C8E6C9 {
    - log_file_path : str
    - endpoint_url : str          // signed URL, from env
    - env, group_id, job_id : str
    - attempt, chunk_index : int
    - fleet, machine_id : str
    - tick_interval_sec : int = 10
    - last_offset : int = 0
    - first_tick : bool = True
    + run() : None                // main loop
    + tick() : None               // one iteration
    - _read_delta() : bytes       // log_file[last_offset:current]
    - _post_chunk(bytes, is_first) : None
    .. behavior ..
    * runs as its own OS process (sibling of handler.py)
    * fire-and-forget POST: any HTTP error is swallowed,
      offset advances unconditionally -> no duplicates,
      no retry logic, no local buffer, no in-worker state
      that can grow unbounded.
    * on first tick, POST carries identity headers so
      backend can build the R2 write path later.
    * NEVER blocks the render.  Blender is a subprocess
      of handler.py with its own PID/memory/GPU state --
      LogStreamer touches none of it.
  }
}

