@startuml allocation_cost_service
title serverV2/allocation -- module structure (post-refactor)\nplanning service owns ALL cost intelligence; aggregator is its private helper

skinparam shadowing false
skinparam BackgroundColor white
skinparam classBackgroundColor #fafafa
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 50

top to bottom direction

' ============================================================
' LAYER 1 -- inbound callers
' ============================================================
together {
    package "<<inbound>>" <<Cloud>> #c7d2fe {
        class "AllocationClient\nserverV2/orchestrator" as Client
        class "Bootstrap\nserverV2/bootstrap" as Boot
        class "API routers\nrender_groups.py" as Router <<endpoint>> #fed8a4 {
            POST /confirm-upload      (tier in body)
            POST /jobs/{id}/retry     (tier from group)
            DELETE /render-groups/{id}    (cancel)
            GET .../cost/estimate    (post-submit)
            POST /pre-render/estimate (pre-submit)
        }
        class "PreRenderEstimator\nserverV2/services/pre_render" as PreRender <<inbound>> {
            estimate_for_payload(...)
            ──
            for tier in (ECONOMY, STANDARD):
              orchestrator.cost_estimate_for_dry_run(
                tier, heaviness, ...)
            (PREMIUM reserved -> null)
        }
    }
}

' ============================================================
' LAYER 2 -- public entry point (the FACADE; thin)
' ============================================================

class AllocationFacade <<entry>> #b9e3a3 {
    ── writes ──
    submit_initial(group_id, tier, ...)    parks TYPE_INITIAL_GROUP
    park_retry(chunk_request, tier, ...)   parks TYPE_RETRY_CHUNK
    drain_for_group(group_id)              cancel cleanup
    ── reads (cost) ──
    cost_estimate_for_group(group_id)      POST: jobs -> planning.cost_for_committed_jobs
    cost_estimate_for_dry_run(tier, ...)   PRE:  snapshot -> planning.cost_for_dry_run
}

' ============================================================
' LAYER 3 -- queues + daemon
' ============================================================
together {
    class AllocationPendingQueueRepository <<repo, queue>> #f9c1c1 {
        ── PURE CRUD ──
        enqueue(item)
        list_all()
        has_any()
        delete / delete_for_group / update_last_attempted_at
        ──
        TYPE_INITIAL_GROUP   (whole render group)
        TYPE_RETRY_CHUNK     (one failed chunk + exclusions)
        ──
        rows carry: group_id, tier, frame slice,
                    type-specific fields
        (heaviness lives on render_groups row,
         NOT here)
    }

    class AllocationDispatchQueueDaemon <<orchestrator, singleton>> #fcd34d {
        every ~2s under Redis lock
        ── _tick() ──
        1. idle guard
        2. snapshot = cache.get_or_build()    [REDIS read]
        3. mutable  = snapshot.to_mutable()
        4. dispatch_tick.process(fleet) per fleet
        5. pending_tick.process(mutable)
        6. cache.persist(...)                 [REDIS write KEEPTTL XX]
    }

    class AllocationDispatchQueueRepository <<repo, queue>> #f9c1c1 {
        ── PURE CRUD ──
        enqueue(group_id, item)
        dequeue_for_fleet(fleet)
        has_any_for_fleets(fleets)
        drain(group_id)
        ──
        already-planned commitments
        (rows carry stamped estimates)
    }
}

' ============================================================
' LAYER 4 -- tick processors
' ============================================================
together {
    class AllocationPendingTickProcessor <<tick phase>> #fef3c7 {
        process(mutable_snapshot) -> int
        --
        rows = pending_repo.list_all()
        for each row:
          // Read FULL heaviness (~20 fields)
          // from the resolved scene blob
          heaviness = rg_repo
              .get_resolved_heaviness(row.group_id)
          --
          if row.type == TYPE_RETRY_CHUNK:
            chunk_req = build from row
            task = planning.plan_retry(
                     tier=row.tier, chunk_request,
                     resources, heaviness)
            tasks = [task] if task else []
          else:    // TYPE_INITIAL_GROUP
            tasks = planning.plan_initial(
                     tier=row.tier, heaviness,
                     resources, ...)
          --
          for each task:
            in_progress dedup, encode,
            dispatch_repo.enqueue(...)
          for each task:
            snapshot_mutator.mark_planned_dispatched()
          pending_repo.delete(row.id)
    }

    class AllocationDispatchTickProcessor <<tick phase>> #fef3c7 {
        process(fleet) -> int
        --
        WHILE under fleet cap:
          item = dispatch_repo.dequeue_for_fleet()
          if group terminal: skip
          decode + build DispatchContext
          claim in_progress ledger
          dispatcher.dispatch_one(...)
              -> fleet strategy fires
              -> writes jobs row
                  (incl. stamped estimates
                   from PlannedTask)
        --
        no snapshot mutation
        (commitment already happened)
    }
}

' ============================================================
' LAYER 5 -- planning service (THE cost-intelligence module)
' ============================================================
package "services/allocation_planning_service" <<Frame>> #fde2e4 {

    class AllocationPlanningService <<entry, planning>> #b9e3a3 {
        ── planning surface (daemon) ──
        plan_initial(
          tier, heaviness, resources, ...)
            -> list[PlannedTask]
        plan_retry(
          tier, chunk_request, resources, heaviness)
            -> PlannedTask | None
        ── cost surface (facade) ──
        cost_for_dry_run(
          tier, heaviness, resources, ...)
            -> GroupCostEstimate
        cost_for_committed_jobs(rows)
            -> GroupCostEstimate
    }

    class AllocationStrategySelector <<helper>> {
        select_name(tier) -> "economy" | "standard" | "premium"
    }

    class CostBearingItem <<value>> #fde68a {
        estimated_cost_usd
        estimated_seconds
    }
    class GroupCostEstimate <<value>> #fde68a {
        chunks
        total_cost_usd
        total_seconds
        wall_time_seconds
    }

    note right of AllocationPlanningService
      private helpers (in same module):
        _aggregate(items)            -> SUM/MAX/COUNT
        _from_planned_tasks(tasks)   -> list[CostBearingItem]
        _from_jobs_rows(rows)        -> list[CostBearingItem]
      cost methods compose: plan -> project -> aggregate
    end note

    AllocationPlanningService --> AllocationStrategySelector
    AllocationPlanningService ..> CostBearingItem : projects to
    AllocationPlanningService ..> GroupCostEstimate : returns
}

' ============================================================
' LAYER 6 -- strategy + algorithm (where cost is CALCULATED)
' ============================================================
package "allocation_strategies" <<Frame>> #e0e7ff {
    together {
        class "Economy / Standard / Premium\nstrategy shells" as Shells <<shell>>
        class AllocationWeights <<value>>
    }
    class AllocationPlanner <<algorithm>> #b9e3a3 {
        plan_initial(weights, heaviness, resources, ...)
        plan_retry(weights, heaviness, chunk_request, resources)
        ──
        For each candidate target:
           composite_scorer.chunk_seconds_for(...)
           composite_scorer.chunk_cost_for(...)
        Pick targets, distribute frames,
        STAMP per-PlannedTask:
           estimated_seconds_per_frame
           estimated_startup_seconds
           estimated_seconds
           estimated_cost_usd        <-- COST ORIGINATES HERE
        ──
        retry path uses chunk_request.excluded_*
        for anti-affinity; otherwise identical scoring
    }
    Shells --> AllocationPlanner : pass weights + heaviness
    Shells ..> AllocationWeights
}

' ============================================================
' LAYER 7 -- external deps
' ============================================================
package "<<external>>" <<Cloud>> #fef3c7 {

    together {
        class "render_groups (table)\n.resolved_scene_json" as RGTable <<repo>> #f9c1c1
        class "jobs (table)" as JobsTable <<repo>> #f9c1c1
    }

    package "fleet_availability\nserverV2/fleets/fleet_availability" <<Frame>> #ddd6fe {
        class FleetAvailabilitySnapshotCache <<cache>> #fde68a {
            get_or_build() -> FleetAvailabilitySnapshot
            persist(frozen)             [KEEPTTL XX]
            ──
            Redis blob, 60s TTL
            (single source of truth
             for fleet availability)
        }
        class FleetAvailabilitySnapshot <<value>> {
            vast_available[]
            modal_available[]
            community_available[]
            serverless_in_flight{}
        }
        FleetAvailabilitySnapshotCache ..> FleetAvailabilitySnapshot : produces
    }

    class "AvailableResources\n(value object passed to planner)" as Resources <<value>>
    class "FleetRegistry +\nfleet strategies" as Fleets
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' --- Inbound -> Facade ---
Client -down-> AllocationFacade : submit_initial / park_retry / drain
Boot   -down-> AllocationFacade
Boot   -down-> AllocationDispatchQueueDaemon : start()
Router -down-> AllocationFacade : drain (cancel)
Router -down-> AllocationFacade : cost_estimate_for_group\n[GET /cost/estimate]
Router -down-> PreRender         : preview\n[POST /pre-render/estimate]
PreRender -down-> Client         : per tier:\ncost_estimate_for_dry_run
Client    -down-> AllocationFacade : pass-through

' --- Facade writes (parking lot) ---
AllocationFacade -down-> AllocationPendingQueueRepository  : enqueue\n[submit_initial / park_retry,\nstamps tier on row]
AllocationFacade -down-> AllocationDispatchQueueRepository : drain\n[cancel]

' --- Facade.cost_estimate_for_group: jobs -> planning ---
AllocationFacade ..> JobsTable                : fetch raw jobs by group_id
AllocationFacade ..> AllocationPlanningService : cost_for_committed_jobs(rows)

' --- Facade.cost_estimate_for_dry_run: snapshot -> planning ---
AllocationFacade ..> FleetAvailabilitySnapshotCache : get_or_build()\n[read-only, no persist]
AllocationFacade ..> Resources                      : adapt(snapshot)
AllocationFacade ..> AllocationPlanningService      : cost_for_dry_run(\n  tier, heaviness, resources, ...)

' --- Daemon orchestration ---
AllocationDispatchQueueDaemon ..> FleetAvailabilitySnapshotCache : get_or_build()\n[start of tick]
AllocationDispatchQueueDaemon ..> FleetAvailabilitySnapshotCache : persist(mutable.to_frozen())\n[end of tick, KEEPTTL XX]
AllocationDispatchQueueDaemon -down-> AllocationPendingTickProcessor  : process(mutable)\n[phase 2]
AllocationDispatchQueueDaemon -down-> AllocationDispatchTickProcessor : process(fleet)\n[phase 1]

' --- Pending tick: read heaviness, plan by row.type, write dispatch_queue ---
AllocationPendingTickProcessor -down-> AllocationPendingQueueRepository  : list_all / delete
AllocationPendingTickProcessor -down-> RGTable                            : get_resolved_heaviness(group_id)\n[FULL ~20-field dict]
AllocationPendingTickProcessor ..> Resources                              : adapt(mutable)
AllocationPendingTickProcessor -down-> AllocationPlanningService          : plan_initial / plan_retry\n(by row.type, with row.tier)
AllocationPendingTickProcessor -down-> AllocationDispatchQueueRepository  : enqueue planned tasks\n(stamped estimates)

' --- Dispatch tick: dequeue, dispatch via fleet ---
AllocationDispatchTickProcessor -down-> AllocationDispatchQueueRepository : dequeue_for_fleet
AllocationDispatchTickProcessor -down-> Fleets                            : dispatch
Fleets ..> JobsTable : INSERT job row\n(with stamped estimates)

' --- Planning service -> strategies ---
AllocationPlanningService -down-> Shells : allocate_initial / allocate_retry

' --- Planner consumes BOTH heaviness AND availability ---
Resources ..> AllocationPlanner : consumed by\nplan_initial / plan_retry

@enduml
