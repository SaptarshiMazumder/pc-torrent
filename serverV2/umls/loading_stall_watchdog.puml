@startuml loading_stall_watchdog
title LoadingStallRule -- end-to-end wiring\n(planner stamps the budget; monitors enforce it; UI surfaces it)

skinparam shadowing false
skinparam BackgroundColor white
skinparam classBackgroundColor #fafafa
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 55

top to bottom direction

' ============================================================
' LAYER 1 -- planner stamps the per-job budget
' ============================================================
package "allocation (planning time)" <<Frame>> #e0e7ff {
    class AllocationPlanner <<algorithm>> #b9e3a3 {
        plan_initial / plan_retry
        ..
        For each PlannedTask
        compute estimated_startup_seconds
        from estimate_startup_seconds(heaviness)
        ..
        90s baseline
        plus 30s per GB blend download
        plus 3s per million verts BVH
        plus 100s per GB texture upload
        plus 5s + 0.05s per shader node
        clamped to MAX_STARTUP_SEC
    }

    class PlannedTask <<value>> #fde68a {
        fleet
        gpu_type
        frame_start, frame_end
        estimated_seconds
        estimated_cost_usd
        estimated_seconds_per_frame
        estimated_startup_seconds (budget seed)
    }

    AllocationPlanner --> PlannedTask : stamps
}

' ============================================================
' LAYER 2 -- fleet strategies thread the budget through dispatch
' ============================================================
package "fleet strategies (dispatch time)" <<Frame>> #e0e7ff {
    class VastFleetStrategy <<strategy>> #b9e3a3 {
        dispatch(task, ctx)
        ..
        1) INSERT INTO jobs with
        estimated_startup_seconds
        equal to task.estimated_startup_seconds
        ..
        2) client.dispatch_job
        ..
        3) callback.start_monitoring(
        estimated_startup_sec equal to
        task.estimated_startup_seconds)
    }
    class ModalFleetStrategy <<strategy>> #b9e3a3 {
        dispatch(task, ctx)
        ..
        same shape as Vast.
        Stamps job row plus
        passes estimated_startup_sec
        to monitor manager.
    }
}

' ============================================================
' LAYER 3 -- monitor managers spawn per-job monitors
' ============================================================
package "monitor managers (per-fleet, lock-protected)" <<Frame>> #fef3c7 {
    class VastMonitorManager <<manager>> #fcd34d {
        start_monitoring(
        job_id, ..., estimated_startup_sec)
        ..
        builds VastInstanceMonitor
        threads estimated_startup_sec
        into ctor
    }
    class ModalMonitorManager <<manager>> #fcd34d {
        start_monitoring(
        job_id, ..., estimated_startup_sec)
        ..
        builds ModalJobMonitor
        threads estimated_startup_sec
        into ctor
    }
    class CommunityMonitor <<scanner>> #fcd34d {
        scan_active_jobs() per tick
        ..
        per-job reads
        job.estimated_startup_seconds
        off the RenderJob row directly.
        Single thread for all
        community jobs; no
        ctor-time threading.
    }
}

' ============================================================
' LAYER 4 -- per-job monitors run the detector
' ============================================================
package "per-job monitors (tick loop)" <<Frame>> #fef3c7 {
    class VastInstanceMonitor <<monitor>> #fcd34d {
        - estimated_startup_sec
        - stall_detector
        - counts (JobCounts)
        ..
        _tick:
        ... liveness checks ...
        stall = _evaluate_stall(job)
        if stall, _on_stall(stall)
        ..
        _evaluate_stall(job):
        window from heartbeat_repo.get_recent
        elapsed equal to now minus started_at
        has_rendered equal to counts.uploaded(job) > 0
        stall_detector.evaluate(
        window, elapsed, has_rendered,
        estimated_startup_sec)
    }
    class ModalJobMonitor <<monitor>> #fcd34d {
        same shape as VastInstanceMonitor.
        _evaluate_stall(job) feeds
        has_rendered plus estimated_startup_sec
        into the shared detector.
    }
}

' ============================================================
' LAYER 5 -- the detector + rule list (shared across fleets)
' ============================================================
package "fleets/shared/pre_render_stall_detector" <<Frame>> #c7d2fe {
    interface IPreRenderStallDetector <<protocol>> {
        evaluate(window, job_age_sec,
        has_rendered, estimated_startup_sec)
        returns StallReason or None
    }

    class PreRenderStallDetector <<impl>> #b9e3a3 {
        rules (list of StallRule)
        ..
        evaluate(...):
        for rule in rules
        reason = rule.evaluate(...)
        if reason then return reason
        return None
        ..
        first match wins
    }

    class PreRenderStallDetectorBuilder <<builder>> {
        with_bytes_stall(...)
        with_download_ceiling(...)
        with_loading_stall (NEW)
        multiplier, min_sec, max_sec
        with_hard_ceiling(...)
        build()
    }

    package "rules (first-match-wins order)" <<Frame>> #ddd6fe {
        class BytesStallRule {
            fires only while
            phase equals download
        }
        class DownloadCeilingRule {
            fires only while
            phase equals download
        }
        class LoadingStallRule <<NEW>> #b9e3a3 {
            fires when
            has_rendered is False
            AND phase not equal to download
            AND elapsed_in_loading
            greater than or equal to
            clamp(estimated_startup_sec
            times multiplier,
            min_sec, max_sec)
            ..
            entered_loading_at equals
            first sample (newest first)
            after the most recent
            download sample
        }
        class HardCeilingRule {
            fires regardless of phase
            at job_age greater than 4h
        }
    }

    PreRenderStallDetectorBuilder --> PreRenderStallDetector : builds
    PreRenderStallDetector ..|> IPreRenderStallDetector
    PreRenderStallDetector --> BytesStallRule : runs
    PreRenderStallDetector --> DownloadCeilingRule : runs
    PreRenderStallDetector --> LoadingStallRule : runs
    PreRenderStallDetector --> HardCeilingRule : runs
}

' ============================================================
' LAYER 6 -- failure flow + DB write
' ============================================================
package "failure flow" <<Frame>> #fde2e4 {
    class StallReason <<value>> #fde68a {
        rule
        message
    }
    class OnStall <<handler>> #f9c1c1 {
        _on_stall(reason)
        ..
        err equals
        Pre-render stall (rule_name) with msg
        ..
        log.warning(...)
        client.instances.destroy(...)
        snapshot.remove()
        on_failure(job_id, err)
    }
    class JobsTable <<repo>> #f9c1c1 {
        UPDATE jobs
        ..
        status equals failed
        error equals
        Pre-render stall (loading_stall) with msg
    }

    OnStall --> JobsTable : UPDATE error and status\nvia CallbackRouter and failure pipeline
}

' ============================================================
' LAYER 7 -- read-side surfacing on the UI
' ============================================================
package "read side" <<Cloud>> #c7d2fe {
    class RenderGroupSerializer <<serializer>> #b9e3a3 {
        serialize_task(job)
        ..
        adds DTO field stall_rule.
        Parsed from job.error via
        _extract_stall_rule using
        a regex matching the prefix
        Pre-render stall (rule_name)
    }
    class DTO <<dto>> #fde68a {
        GET /render-groups/(id)
        ..
        tasks(i):
        status equal to failed
        error equal to Pre-render stall (...)
        stall_rule equal to loading_stall or null (NEW)
    }
    class FRow <<component>> #fed8a4 {
        FinishedRow.jsx
        ..
        if data.stallRule
        render inst-fin-pill with
        STALL_RULE_LABELS lookup
        ..
        loading_stall means loading stall
        bytes_stall means bytes stall
        download_ceiling means download ceiling
        hard_ceiling means hard ceiling
    }

    JobsTable ..> RenderGroupSerializer : SELECT row
    RenderGroupSerializer --> DTO : projects
    DTO --> FRow : renders badge
}

' ============================================================
' RELATIONSHIPS -- top-down flow of estimated_startup_seconds
' ============================================================

AllocationPlanner -down-> VastFleetStrategy  : task carries\nestimated_startup_seconds
AllocationPlanner -down-> ModalFleetStrategy : task carries\nestimated_startup_seconds

VastFleetStrategy  -down-> VastMonitorManager  : start_monitoring(estimated_startup_sec)
ModalFleetStrategy -down-> ModalMonitorManager : start_monitoring(estimated_startup_sec)

VastMonitorManager  -down-> VastInstanceMonitor : ctor estimated_startup_sec
ModalMonitorManager -down-> ModalJobMonitor    : ctor estimated_startup_sec

' Community reads off the row directly -- no manager threading
JobsTable ..up..> CommunityMonitor : reads job.estimated_startup_seconds\nper-job, single-thread scanner

' Monitors invoke the detector with the threaded budget
VastInstanceMonitor -down-> PreRenderStallDetector : evaluate(\nhas_rendered = counts.uploaded(job) > 0,\nestimated_startup_sec)
ModalJobMonitor    -down-> PreRenderStallDetector
CommunityMonitor   -down-> PreRenderStallDetector

' Bootstrap factory wires the rules in order
note left of PreRenderStallDetectorBuilder #ddffdd
  bootstrap._make_pre_render_stall_detector():
    builder = PreRenderStallDetectorBuilder()
      .with_bytes_stall(...)
      .with_download_ceiling(...)
      .with_loading_stall(   (NEW)
        multiplier = cfg.stall.loading_multiplier      default 3.0
        min_sec    = cfg.stall.loading_phase_min_sec   default 60
        max_sec    = cfg.stall.loading_phase_max_sec   default 1800)
      .with_hard_ceiling(...)
      .build()
end note

' Stall fire path
PreRenderStallDetector -down-> StallReason : returns
StallReason ..> OnStall : drives

@enduml
