# ============================================================
# Forge -- dev environment
# Copy this to .env (gitignored) and fill in.  Values produced by
# `terraform output` should overwrite their lines automatically when
# you run `infra/scripts/deploy.sh dev` for the first time.
# ============================================================

# -------- Identity (set manually before first apply) ----------------
ENV_NAME=dev
GCP_PROJECT=gen-lang-client-0545494042
GCP_REGION=asia-northeast1
SERVICE_NAME=pc-rent-server-v2-dev

# Firebase project for THIS env -- you create it manually in the
# Firebase Console once, paste the service-account JSON below.
FIREBASE_PROJECT_ID=pc-rent-dev
FIREBASE_SERVICE_ACCOUNT_JSON=

# -------- Data layer (filled by `terraform output`) -----------------
DATABASE_URL=
REDIS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pc-rent-dev-blends
# Separate bucket for worker stdout logs (jobs_logger).  Kept apart from
# frames so retention lifecycle can be tightened without touching user
# output.  Create the bucket manually in the Cloudflare R2 dashboard
# alongside the blends bucket; reuses the same account-scoped API keys.
R2_LOGS_BUCKET_NAME=pc-rent-logs-dev

# -------- Public URL (filled by Cloud Run after first deploy) ------
PUBLIC_BACKEND_URL=

# -------- Modal (one workspace, per-env app name) -----------------
# Generate per-env token via `modal token new`; paste here.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=pc-rent-render-dev
MODAL_WORKSPACE=
# Default to the working test tags so a fresh .env works out of the
# box.  Bump to ``pc-rent-modal-worker-cycles:dev-vX.Y.Z`` after
# ``push-worker.sh dev <ver> modal-cycles`` if you want isolation.
MODAL_WORKER_IMAGE_CYCLES=ghcr.io/saptarshimazumder/pcrent-modal-worker-cycles:5.0.4

# -------- Vast.ai (single account; default to test tags) ----------
VAST_API_KEY=
VAST_DOCKER_IMAGE=ghcr.io/saptarshimazumder/pcrent-vast-worker-cycles:5.0.4
VAST_DOCKER_IMAGE_EEVEE=ghcr.io/saptarshimazumder/pcrent-vast-worker-eevee:5.0.4

# -------- Community (the agent on user PCs pulls this) ------------
# Required.  serverV2 boot fails loud if missing.  Returned by
# GET /community/worker-image so a single agent binary works against
# any env -- whichever backend it's pointed at, it gets the right tag.
COMMUNITY_WORKER_IMAGE=ghcr.io/saptarshimazumder/pcrent-community-worker-cycles:latest

# -------- LLM providers (per-env keys; OpenAI required) -----------
ANTHROPIC_API_KEY=PLACEHOLDER_REPLACE_ME
OPENAI_API_KEY=

# -------- Internal -----------------------------------------------
ORPHAN_SECRET=
# Per-env prefix for FIXED Redis keys (singleton locks, aggregate keys).
# Required when sharing one Redis across envs.  Prod leaves empty.
REDIS_KEY_PREFIX=dev:
